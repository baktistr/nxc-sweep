#!/bin/bash

# --- Colors ---
BLUE='\033[0;34m'
YELLOW='\033[38;5;226m'
GREEN='\033[0;32m'
GREY='\033[38;5;244m'
RED='\033[0;31m'


# --- Help Menu ---
usage() {
    echo -e "${YELLOW}Usage: nxc-sweep <IP|CIDR> -u <username> (-p <password> | -H <hash>) [global flags]"
    exit 1
}


# pulls IP first like in native nxc syntax
if [[ -z "$1" || "$1" == -* ]]; then
    usage
fi

TARGET=$1
shift # shifts arguments over so $2 becomes $1, etc.

# parses the remaining flags (-u, -p, -H, and anything else like --local-auth)
GLOBAL_FLAGS=()
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -u) USER=$2; shift 2 ;;
        -p) PASS=$2; shift 2 ;;
        -H) HASH=$2; shift 2 ;;
        *) GLOBAL_FLAGS+=("$1"); shift 1 ;;
    esac
done


# validation check
if [[ -z "$TARGET" || -z "$USER" ]]; then
    usage
fi

# require exactly one of -p / -H
if [[ -n "$PASS" && -n "$HASH" ]]; then
    echo -e "${RED}[!] -p and -H are mutually exclusive. Pick one."
    usage
fi
if [[ -z "$PASS" && -z "$HASH" ]]; then
    usage
fi

# build auth flag once so each protocol call stays clean
if [[ -n "$HASH" ]]; then
    AUTH_FLAG="-H"
    AUTH_VALUE="$HASH"
    AUTH_LABEL="hash"
else
    AUTH_FLAG="-p"
    AUTH_VALUE="$PASS"
    AUTH_LABEL="password"
fi

# note whether --local-auth was passed so protocols that can't use it get skipped
LOCAL_AUTH=0
for flag in "${GLOBAL_FLAGS[@]}"; do
    if [[ "$flag" == "--local-auth" ]]; then
        LOCAL_AUTH=1
        break
    fi
done

# subnet mode: when TARGET is a CIDR, skip the per-host nc preflight and
# let nxc iterate the range natively (matches `nxc smb 10.0.0.0/24 ...` behavior)
IS_SUBNET=0
if [[ "$TARGET" == */* ]]; then
    IS_SUBNET=1
    echo -e "${BLUE}[*] Starting NXC subnet sweep for $TARGET as $USER (${AUTH_LABEL} auth) ...\n"
else
    echo -e "${BLUE}[*] Starting NXC sweep for $TARGET as $USER (${AUTH_LABEL} auth) ...\n"
fi

# --- Protocol Handler ---
check_and_run() {
    local PORT=$1
    local PROTO=$2
    shift 2

    # FTP doesn't support pass-the-hash, so skip it cleanly when in hash mode
    if [[ "$PROTO" == "ftp" && "$AUTH_FLAG" == "-H" ]]; then
        echo -e "${GREY}[-] Skipping ftp (pass-the-hash not supported)"
        echo ""
        return
    fi

    # LDAP is a domain service, so --local-auth can never authenticate against it
    if [[ "$PROTO" == "ldap" && "$LOCAL_AUTH" == "1" ]]; then
        echo -e "${GREY}[-] Skipping ldap (--local-auth not supported)"
        echo ""
        return
    fi

    local EXTRA_FLAGS=("$@")
    local SAFE_GLOBAL_FLAGS=()

    # filters out --local-auth for FTP to prevent crashes
    for flag in "${GLOBAL_FLAGS[@]}"; do
        if [[ "$PROTO" == "ftp" && "$flag" == "--local-auth" ]]; then
            continue # Skip this specific flag
        fi
        SAFE_GLOBAL_FLAGS+=("$flag")
    done

    # subnet mode: skip nc check, hand the CIDR straight to nxc
    if [[ "$IS_SUBNET" == "1" ]]; then
        echo -e "${GREEN}[+] Sweeping ${PROTO} across ${TARGET} ..."
        nxc "$PROTO" "$TARGET" -u "$USER" "$AUTH_FLAG" "$AUTH_VALUE" "${SAFE_GLOBAL_FLAGS[@]}" "${EXTRA_FLAGS[@]}"
        echo ""
        return
    fi

    # single-host mode: checks if the port is open before running NXC to save time
    if nc -z -w 1 "$TARGET" "$PORT" 2>/dev/null; then
        echo -e "${GREEN}[+] Port $PORT open. Checking ${PROTO} ..."
        # run normally for everything to preserve native NXC colors
        nxc "$PROTO" "$TARGET" -u "$USER" "$AUTH_FLAG" "$AUTH_VALUE" "${SAFE_GLOBAL_FLAGS[@]}" "${EXTRA_FLAGS[@]}"
    else
        echo -e "${GREY}[-] Port $PORT closed/filtered. Skipping ${PROTO}"
    fi
    echo ""
}

# --- Protocols ---
check_and_run 445 "smb" "--shares"
check_and_run 389 "ldap" "--users"
check_and_run 5985 "winrm"
check_and_run 3389 "rdp"
check_and_run 1433 "mssql" -q "SELECT name FROM master.sys.databases;"
check_and_run 21 "ftp" "--ls"
# if you want to add more or customize the options, just follow the syntax above


echo -e "${BLUE}[*] All active services checked."
